# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and populate credentials as needed.
# ==============================================================================

# Operational Mode (development | staging | production)
ENVIRONMENT=production
DEBUG=false

# Server Network Binding
HOST=127.0.0.1
PORT=8000

# Security & Request Constraints
MAX_TEXT_LENGTH=50000
MAX_TITLE_LENGTH=1000
SCRAPER_TIMEOUT_SECONDS=12.0

# Live Fact Consensus Configuration
# (Optional) Google Fact Check Tools API Key for ClaimReview querying
GOOGLE_FACTCHECK_API_KEY=

# Cache Settings
WIRE_CACHE_TTL_SECONDS=600
MIN_CORROBORATION_OVERLAP=0.45
